# ClipWaltz AISERVER API wrapper config — EXAMPLE (no real secret here).
# The live copy lives at /opt/clipwaltz-ai/config/wrapper.env on AISERVER,
# chmod 600, owned by the service user. The real CW_API_TOKEN is generated on
# the host and delivered to the owner out-of-band — NEVER committed.

CW_API_TOKEN=replace-with-generated-secret
# Bind to the LAN IP so the ClipWaltz backend on linuxg1 (192.168.166.1) can
# reach it. NOT 0.0.0.0 unless required, and never routed to the public internet.
CW_BIND_HOST=192.168.166.158
CW_BIND_PORT=8189
COMFYUI_URL=http://127.0.0.1:8188
CW_WORKFLOW_DIR=/opt/clipwaltz-ai/workflows
CW_OUTPUT_DIR=/data/clipwaltz-ai/output
CW_INPUT_DIR=/data/clipwaltz-ai/input
CW_LOG_DIR=/opt/clipwaltz-ai/logs
CW_DATA_MOUNT=/data
