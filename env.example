# ---------------------------------------------------------------------------
# ClipWaltz — environment. Copy to .env.local and fill in. NEVER commit .env*.
# ---------------------------------------------------------------------------

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000        # prod: https://www.clipwaltz.com

# --- Better Auth (self-hosted; no third-party account) ---
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000            # prod: https://www.clipwaltz.com

# Require email verification on sign-up (needs SES configured below):
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --- Social login (optional): list providers AND set creds to show buttons ---
# e.g. NEXT_PUBLIC_AUTH_SOCIAL=google
NEXT_PUBLIC_AUTH_SOCIAL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Database (Postgres / Drizzle) ---
DATABASE_URL=postgres://user:pass@localhost:5432/clipwaltz

# --- Object storage (S3-compatible: MinIO on linuxg7) ---
S3_ENDPOINT=http://linuxg7:9000
S3_BUCKET=clipwaltz
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Email (Amazon SES via SMTP; if unset, emails log to console) ---
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
EMAIL_FROM=ClipWaltz <noreply@clipwaltz.com>

# --- Billing (Stripe, direct; test keys in dev) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

# --- Web Push (render-complete OS notifications; app-only, not the worker) ---
# Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@clipwaltz.com
# Must equal VAPID_PUBLIC_KEY (exposed to the browser to build push subscriptions):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Social Publishing (ADR-0011; src/lib/social, worker/social-worker.mjs) ---
# Off by default: while off, only ADMIN_EMAILS accounts can use it. "1" or "true" opens it to Plus/Pro workspaces.
SOCIAL_PUBLISHING_ENABLED=
# Optional: limit which networks are offered (comma list of provider ids; default = all).
SOCIAL_ENABLED_PROVIDERS=
# Signed media URLs networks fetch (Threads/Instagram/TikTok). Defaults to BETTER_AUTH_SECRET when unset.
SOCIAL_MEDIA_URL_SECRET=
# Social copy model on the AI Box; default qwen3.8:27b.
SOCIAL_AI_MODEL=
# HMAC key for the OAuth state cookie. Defaults to a key derived from BETTER_AUTH_SECRET when unset.
SOCIAL_OAUTH_STATE_SECRET=
# Email destinations: max sends per workspace per rolling 24 h (default 200; 0 = none).
SOCIAL_EMAIL_DAILY_CAP=
# Email destinations: List-Unsubscribe target (an address or an https: URL). Default: the EMAIL_FROM address.
SOCIAL_EMAIL_UNSUBSCRIBE=
# Shared with other features — listed here because Social Publishing needs them too:
# site admins (the only users while the flag is off), the AI Box, and the token-encryption key.
ADMIN_EMAILS=lacy@phoenixtekk.com
OLLAMA_URL=
TOKEN_ENC_KEY=
# Worker: parallel publish jobs per process (default 4).
SOCIAL_WORKER_CONCURRENCY=
# --- P5: podcast, explainers, Shorts ---
# Podcast download counting: salt for the client hash (IP + user agent, never stored). Defaults to BETTER_AUTH_SECRET.
PODCAST_ANALYTICS_SALT=
# Explainer / Short rendering runs on the RENDER WORKER (AI box .env.worker), not the app. There:
#   ELEVENLABS_API_KEY            narration (billed per character)
#   ELEVENLABS_VOICE_ID           the OWNER's cloned voice — used only for site-admin workspaces
#   ELEVENLABS_DEFAULT_VOICE_ID   stock voice for every other workspace (prod: XrExE9yKIg1WjnnlVkGX "Matilda", premade)
#   ELEVENLABS_MODEL              optional, default eleven_multilingual_v2
#   EXPLAINER_OLLAMA_URL / EXPLAINER_OLLAMA_MODEL   script model (default the AI Box, qwen3.8:27b)
#   WORKPLACE_STORE_URL           optional, default https://workplace.phoenixtekk.com (admin-workspace Shorts only)
#   SOCIAL_RENDER_DISABLED=1      turn the explainer/Short loop off on that worker
# The web app itself never calls ElevenLabs; prod keeps the same values in .env.local as well, for the record.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_DEFAULT_VOICE_ID=
# Channel credentials are encrypted with TOKEN_ENC_KEY (same key as Cloud storage tokens); the worker needs the same value.
# OAuth redirect URI to register with EVERY provider: ${NEXT_PUBLIC_APP_URL}/api/social/oauth/<provider>/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=
THREADS_CLIENT_ID=
# Also verifies Meta's Threads deauthorize / data-deletion signed_request callbacks.
THREADS_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Bluesky PDS for app-password sign-in (default https://bsky.social).
BLUESKY_PDS=
