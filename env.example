# ---------------------------------------------------------------------------
# ClipWaltz — environment. Copy to .env.local and fill in. NEVER commit .env*.
# ---------------------------------------------------------------------------

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000        # prod: https://www.clipwaltz.com

# --- Better Auth (self-hosted; no third-party account) ---
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000            # prod: https://www.clipwaltz.com

# Require email verification on sign-up (needs SES configured below):
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --- Social login (optional): list providers AND set creds to show buttons ---
# e.g. NEXT_PUBLIC_AUTH_SOCIAL=google
NEXT_PUBLIC_AUTH_SOCIAL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Database (Postgres / Drizzle) ---
DATABASE_URL=postgres://user:pass@localhost:5432/clipwaltz

# --- Object storage (S3-compatible: MinIO on linuxg7) ---
S3_ENDPOINT=http://linuxg7:9000
S3_BUCKET=clipwaltz
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Email (Amazon SES via SMTP; if unset, emails log to console) ---
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
EMAIL_FROM=ClipWaltz <noreply@clipwaltz.com>

# --- Billing (Stripe, direct; test keys in dev) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

# --- Web Push (render-complete OS notifications; app-only, not the worker) ---
# Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@clipwaltz.com
# Must equal VAPID_PUBLIC_KEY (exposed to the browser to build push subscriptions):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
